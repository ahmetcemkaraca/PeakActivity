## Firestore Security Rules

```javascript
// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User authentication function
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User ownership check
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Team membership check
    function isTeamMember(teamId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }
    
    // Premium subscription check
    function hasPremiumAccess(userId) {
      let userData = get(/databases/$(database)/documents/users/$(userId)).data;
      return userData.subscription.tier in ['premium', 'pro'] && 
             userData.subscription.status == 'active';
    }
    
    // User documents
    match /users/{userId} {
      // Users can read and write their own profile
      allow read, write: if isOwner(userId);
      
      // Team members can read limited information
      allow read: if isAuthenticated() && 
        resource.data.privacySettings.teamInsightsSharing == true;
      
      // Subcollections
      match /activities/{activityId} {
        allow read, write: if isOwner(userId);
        
        // Data size check
        allow create: if isOwner(userId) && 
          request.resource.data.size() < 5000;
      }
      
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
      
      match /insights/{insightId} {
        allow read, write: if isOwner(userId);
        
        // Only system insights can be created
        allow create: if false;
      }
      
      match /daily_reports/{reportId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false; // Only Cloud Functions
      }
      
      match /weekly_reports/{reportId} {
        allow read: if isOwner(userId) && hasPremiumAccess(userId);
        allow create, update, delete: if false; // Only Cloud Functions
      }
      
      match /automation_rules/{ruleId} {
        allow read, write: if isOwner(userId);
        
        // Premium feature check
        allow create: if isOwner(userId) && 
          (hasPremiumAccess(userId) || 
           get(/databases/$(database)/documents/users/$(userId)/automation_rules).size() < 3);
      }
    }
    
    // Team documents
    match /teams/{teamId} {
      // Team members can read
      allow read: if isTeamMember(teamId);
      
      // Only admins and managers can write
      allow write: if isAuthenticated() && 
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.members[request.auth.uid].role in ['admin', 'manager'];
      
      // New team creation (Pro subscription required)
      allow create: if isAuthenticated() && 
        hasPremiumAccess(request.auth.uid);
    }
    
    // Subscription information
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow write: if false; // Only payment system updates
    }
    
    // System collections - only readable
    match /app_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }
    
    match /system_insights/{insightId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }
    
    // Admin collections - no access
    match /performance_metrics/{metricId} {
      allow read, write: if false;
    }
    
    match /error_logs/{logId} {
      allow read, write: if false;
    }
    
    match /analytics_events/{eventId} {
      allow read, write: if false;
    }
  }
}
```

