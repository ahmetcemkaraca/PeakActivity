{
  "name": "peakactivity-functions",
  "version": "0.2.8",
  "description": "Firebase Cloud Functions for PeakActivity - AI-powered productivity tracking",
  "main": "lib/index.js",
  "engines": {
    "node": "18"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "express": "^4.18.2",
    "@genkit-ai/googleai": "^0.5.0",
    "genkit": "^0.5.0",
    "zod": "^3.22.4",
    "cors": "^2.8.5",
    "@google-cloud/language": "^6.0.0",
    "@google-cloud/logging": "^11.0.0",
    "axios": "^1.6.0",
    "iso8601-duration": "^2.1.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.0",
    "jira-client": "^8.2.2",
    "googleapis": "^128.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/lodash": "^4.14.202",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "private": true,
  "keywords": [
    "firebase",
    "cloud-functions",
    "activitywatch",
    "ai",
    "productivity",
    "analytics"
  ],
  "author": "PeakActivity Team",
  "license": "MIT"
}
