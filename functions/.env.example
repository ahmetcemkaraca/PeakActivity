# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google AI / Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud Services
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json

# OpenAI (Optional - for future multi-provider support)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (Optional - for future multi-provider support)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Trello Integration
TRELLO_API_KEY=your-trello-api-key
TRELLO_TOKEN=your-trello-token

# Jira Integration
JIRA_HOST=your-company.atlassian.net
JIRA_USERNAME=your-jira-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret

# App Configuration
NODE_ENV=development
LOG_LEVEL=debug

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Feature Flags
ENABLE_PRAISONAI_AGENTS=true
ENABLE_EDGE_AI=false
ENABLE_ADVANCED_ANALYTICS=true

# Rate Limiting
MAX_AGENT_RUNS_PER_USER_PER_DAY=10
MAX_API_REQUESTS_PER_MINUTE=100
