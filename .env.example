# PeakActivity - Root Environment Variables

# Firebase Admin SDK
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-project-id

# aw-server Configuration
AW_SERVER_PORT=5600
AW_SERVER_HOST=127.0.0.1
AW_TESTING=false
AW_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Firestore Configuration
USE_FIRESTORE=true
ANONYMIZE_ACTIVITY_DATA=false

# PraisonAI Configuration
PRAISONAI_MODEL=gemini-1.5-flash-8b
GEMINI_API_KEY=your-gemini-api-key

# Logging
LOG_LEVEL=INFO
ENABLE_CLOUD_LOGGING=false

# Security
SECRET_KEY=your-secret-key-for-encryption

# Development
DEV_MODE=true
